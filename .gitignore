# ==============================================================================
# IEEE-CIS Fraud Detection / Sentinel MLOps Platform — Git Ignore Rules
# ==============================================================================

# --- AI Assistants & Agent Artefacts ---
.claude/
.claude*
.cursor/
.cursorrules
.windsurf/
.copilot/
.aider*
.gemini/
.agents/
.cody/
.continue/
.antigravity/
.freebuff/

# --- Dataset & Heavy Data Files ---
data/raw/
data/interim/
data/processed/
data/models/*
data/feedback/*
data/decisions/*
dataset/
raw_data/
*.csv
*.parquet
*.zip
*.gz
*.tar
*.h5
*.hdf5
*.pkl
*.pickle
*.feather
*.sqlite
*.sqlite3
*.db

# Whitelist committed sample & metadata files
!data/.gitkeep
!data/models/.gitkeep
!data/feedback/.gitkeep
!data/decisions/.gitkeep
!data/metadata/
!data/metadata/*.csv
!data/metadata/*.json
!dashboard/data/
!dashboard/data/*.csv
!dashboard/data/*.parquet
!web/sample_transactions.csv

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
.virtual_documents/

# --- Python & Build Artefacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# --- Virtual Environments & Secrets ---
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
*.env

# --- ML Models & Outputs ---
models/
*.keras
*.model
*.pth
*.pt
*.onnx
*.joblib
checkpoints/
tensorboard/
mlruns/

# Whitelist baked demo models if explicitly placed under metadata
!data/metadata/demo_model.joblib

# --- Testing & Quality Assurance ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.cover
.benchmarks/
.hypothesis/

# --- Operating System & Editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vs/
.history/
.fleet/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Documentation Build ---
docs/build/

# --- Miscellaneous & Logs ---
*.log
*.bak
*.tmp
*.temp
.cache/
.ruff_cache/
.mypy_cache/
.dmypy.json

# --- Node / Frontend SPA (Vite / React) ---
node_modules/
web/node_modules/
web/dist/
web/.vite/
.vite/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
